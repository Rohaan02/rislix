{
  "name": "rislix-grc-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --import tsx --watch bin/server.ts",
    "build": "node --import tsx ace build",
    "start": "node bin/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migration:run": "node --import tsx ace migration:run",
    "migration:rollback": "node --import tsx ace migration:rollback",
    "db:seed": "node --import tsx ace db:seed",
    "generate:key": "node --import tsx ace generate:key",
    "test": "node --import tsx --test tests/**/*.spec.ts"
  },
  "imports": {
    "#services/activity_logger": "./app/services/activity_logger.js",
    "#services/compliance_score": "./app/services/compliance_score.js",
    "#services/file_storage": "./app/services/file_storage.js",
    "#helpers/*": "./app/helpers/*.js",
    "#services/*": "./app/services/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#models/*": "./app/models/*.js",
    "#validators/*": "./app/validators/*.js",
    "#config/*": "./config/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.2.3",
    "@adonisjs/core": "^6.21.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^21.3.0",
    "@vinejs/vine": "^2.1.0",
    "exceljs": "^4.4.0",
    "luxon": "^3.5.0",
    "mysql2": "^3.11.0",
    "otpauth": "^9.5.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^1.3.0",
    "@adonisjs/prettier-config": "^1.3.0",
    "@adonisjs/tsconfig": "^1.3.0",
    "@swc/core": "^1.7.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.0.0",
    "eslint": "^8.57.0",
    "hot-hook": "^0.3.0",
    "jiti": "^1.21.6",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "tsx": "^4.22.4",
    "typescript": "~5.5.4"
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/app"
  },
  "prettier": "@adonisjs/prettier-config",
  "allowScripts": {
    "@swc/core@1.15.43": true,
    "esbuild@0.28.1": true
  }
}
